# Server
PORT=3001
NODE_ENV=development

# Required in production: only you can create games when this is set.
# Friends join with invite codes — they never need this password.
HOST_PASSWORD=

# Comma-separated allowed browser origins (only needed if web and API are on different hosts).
# When the server serves the built web app from the same URL, you usually do not need this.
# CORS_ORIGINS=https://blind-guides.example.com

# Serve the built React app from the same process (auto-enabled when NODE_ENV=production).
# SERVE_STATIC=true

# Path to the Vite build output (default: apps/web/dist relative to server package).
# STATIC_DIR=

# Persisted game files (default: ./data/games under the server working directory).
# On Render/Fly/Railway, mount a volume at this path so games survive restarts.
# DATA_DIR=
